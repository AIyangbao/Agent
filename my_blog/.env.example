# ============================================
# 博客项目环境变量示例
# 复制本文件为 .env 并填入真实值（.env 不会被提交）
# ============================================

# MySQL 数据库
DB_PWD=your_mysql_password_here
DB_NAME=blog_db

# JWT 认证密钥（随便一串随机字符串，建议 32 位以上）
JWT_PWD=your_jwt_secret_here

# 通义千问 API（阿里云 DashScope）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen-plus

# CORS 白名单（必须是 JSON 数组字符串，pydantic-settings 2.x 会 json.loads 解析）
# 多个域名用逗号分隔在数组内；本地调试可加 http://localhost:80
CORS_ORIGINS=["https://blog.fireflyai.site","http://localhost:80"]

# 短信验证码是否走 mock（true=不真发短信，直接返回验证码用于开发；生产填 false）
SMS_MOCK=true
